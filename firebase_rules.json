{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "data": {
          "history": {
            "$key": {
              ".validate": "newData.hasChildren(['episode_number'])"
            }
          },
          "favourites": {
            "$key": {
              ".validate": "newData.hasChild('is_favourite')"
            }
          }
        }
      }
    }
  }
}
